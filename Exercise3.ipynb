    "# Question 14\n",
    "L = collect(1:10)\n",
    "S = [\n",
    "    [1, 2, 5],      # S1\n",
    "    [1, 3, 4],      # S2\n",
    "    [2, 6],         # S3\n",
    "    [3, 7],         # S4\n",
    "    [4, 5, 8],      # S5\n",
    "    [6, 9],         # S6\n",
    "    [7, 10],        # S7\n",
    "    [8, 9, 10],     # S8\n",
    "    [1, 6, 8],      # S9\n",
    "    [2, 4, 7],      # S10\n",
    "    [1, 5, 9],      # S11\n",
    "    [6, 10]         # S12\n",
    "]\n",
    "c = [9, 8, 7, 6, 10, 11, 12, 14, 13, 9, 10, 8]\n",
    "\n",
    "K = 1:length(S)\n",
    "N = 1:length(L)\n",
    "\n",
    "ratio = [c[k]/length(S[k]) for k=K]\n",
    "\n",
    "cost = 0\n",
    "for i=N    \n",
    "    cost_i = minimum(ratio[k] for k=K if i in S[k])\n",
    "    cost = cost + cost_i\n",
    "end\n",
    "print(cost)"
   ]
  }
