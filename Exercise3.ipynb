   "source": [
    "\n",
    "objective function\n",
    "$$\n",
    "\\min \\sum_{j \\in S} c_j x_j + \\sum_{i=1}^{10} p_i \\big( \\sum_{j \\in S_i} x_j - 1 \\big)\n",
    "$$\n",
    "\n",
    "constraint:\n",
    "$\\forall i=1,...k$:\n",
    "$$\n",
    "\\sum_{j \\in S_i} x_j \\geq 1 \n",
    "$$\n",
    "and $\\forall j=1,...k$:\n",
    "$$\n",
    "x_j \\in {0,1}\n",
    "$$"
   ]
  },
